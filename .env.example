# GSNSD Environment Configuration

# API URL Configuration
# ---------------------
# For local development with backend running on port 5000:
# VITE_API_URL=http://localhost:5000/api
#
# For production (when frontend and backend are on the same server):
# Leave empty or don't set - the app will use relative URLs (/api)
# VITE_API_URL=
#
# For production with separate backend server:
# VITE_API_URL=https://your-backend-domain.com/api

VITE_API_URL=
